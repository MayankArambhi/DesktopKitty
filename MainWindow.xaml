<Window x:Class="TinyBongo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desktop Kitty"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        MinWidth="220"
        MinHeight="220"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Grid ClipToBounds="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="0"
                Margin="0"
                Background="Transparent">
            <Image x:Name="CatImage"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   Stretch="Uniform">
                <Image.ContextMenu>
                    <ContextMenu FontFamily="Comic Sans MS">
                        <MenuItem x:Name="ToggleCounterMenuItem"
                                  Header="Hide Counter"
                                  Click="ToggleCounterMenuItem_Click" />
                        <MenuItem Header="Statistics..."
                                  Click="StatisticsMenuItem_Click" />
                        <MenuItem Header="Reset Counter"
                                  Click="ResetCounter_Click" />
                        <Separator />
                        <MenuItem x:Name="StartWithWindowsMenuItem"
                                  Header="Start With Windows"
                                  IsCheckable="True"
                                  Click="StartWithWindowsMenuItem_Click" />
                        <Separator />
                        <MenuItem Header="Exit"
                                  Click="ExitMenuItem_Click" />
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </Border>

        <Border x:Name="CounterBorder"
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,-5,0,0"
                Background="White"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="12"
                Padding="12,6"
                MinHeight="30">
            <TextBlock x:Name="CounterText"
                       Text="0"
                       FontFamily="Comic Sans MS"
                       FontWeight="Bold"
                       FontSize="15"
                       Foreground="Black"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       LineHeight="18"
                       TextWrapping="NoWrap" />
        </Border>
    </Grid>
</Window>
