<Window x:Class="TinyBongo.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="White">
    <Window.Resources>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Comic Sans MS" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="14"
            Margin="8"
            Padding="18,16">
        <StackPanel MinWidth="300">
            <TextBlock Text="Statistics"
                       FontFamily="Comic Sans MS"
                       FontWeight="Bold"
                       FontSize="18"
                       Foreground="Black"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,14" />

            <Grid x:Name="StatsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="110" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="📅 Running For" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RunningForValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="👆 Lifetime Clicks" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LifetimeClicksValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="⌨ Keyboard Clicks" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="KeyboardClicksValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="🖱 Mouse Clicks" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="MouseClicksValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="⌨ Keyboard Percentage" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="KeyboardPercentValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="🖱 Mouse Percentage" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="MousePercentValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="📊 Average Clicks / Day" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="AveragePerDayValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="⏱ Average Active Clicks / Hour" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="AveragePerHourValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Text="🏆 Next Milestone" Style="{StaticResource StatLabelStyle}" Margin="0,4,0,6" />

                <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                        x:Name="MilestoneTrack"
                        Height="14"
                        Background="#DDDDDD"
                        CornerRadius="3"
                        Margin="0,0,0,6">
                    <Border x:Name="MilestoneFill"
                            Background="#333333"
                            CornerRadius="3"
                            HorizontalAlignment="Left"
                            Width="0" />
                </Border>

                <TextBlock Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                           x:Name="MilestoneValue"
                           FontFamily="Comic Sans MS"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="Black"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />

                <Border Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                        BorderBrush="#CCCCCC"
                        BorderThickness="0,1,0,0"
                        Margin="0,2,0,10" />

                <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Session"
                           FontFamily="Comic Sans MS"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="Black"
                           Margin="0,0,0,8" />

                <TextBlock Grid.Row="13" Grid.Column="0" Text="Today's Clicks" Style="{StaticResource StatLabelStyle}" />
                <TextBlock Grid.Row="13" Grid.Column="1" x:Name="TodayClicksValue" Style="{StaticResource StatValueStyle}" />

                <TextBlock Grid.Row="14" Grid.Column="0" Text="Current Session" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,0" />
                <TextBlock Grid.Row="14" Grid.Column="1" x:Name="SessionClicksValue" Style="{StaticResource StatValueStyle}" Margin="0,0,0,0" />
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Session Duration" Style="{StaticResource StatLabelStyle}" Margin="0,0,0,14" />
                <TextBlock Grid.Column="1" x:Name="SessionDurationValue" Style="{StaticResource StatValueStyle}" Margin="0,0,0,14" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,10">
                <Button Content="Refresh"
                        Width="90"
                        Height="28"
                        Margin="0,0,8,0"
                        FontFamily="Comic Sans MS"
                        Click="RefreshButton_Click" />
                <Button Content="Close"
                        Width="90"
                        Height="28"
                        FontFamily="Comic Sans MS"
                        Click="CloseButton_Click" />
            </StackPanel>

            <Button Content="About DesktopKitty"
                    Height="28"
                    FontFamily="Comic Sans MS"
                    Click="AboutButton_Click" />
        </StackPanel>
    </Border>
</Window>
